import ../config.js

# Points a held copper goat horn at the instrument for the player's current stance.
# The horn reads its instrument when use starts, so the swap runs every tick while it is held.
# Sneaking plays the bass part, looking up past copperGoatHorn.minHarmonyPitch plays the harmony, anything else the melody.
# Expects satyrn.fdl.copperGoatHorn.currentPitch to be set on the player.
#
# Parameters:
# 0 - The non-numeric slot ID of the horn.
# 1 - The song name, matching CustomInstrument in the horn's custom data.
template horn_swap {
    with a0:word a1:word {
        execute if items entity @s <%a0%> minecraft:goat_horn[minecraft:custom_data~{CustomInstrument:"<%a1%>"}] run {
            execute if predicate foxcraft_dungeon_loot:is_sneaking run {
                execute unless items entity @s <%a0%> *[minecraft:instrument="foxcraft_dungeon_loot:<%a1%>_bass"] run item modify entity @s <%a0%> foxcraft_dungeon_loot:copper_horn/<%a1%>_bass
            } else execute if score @s satyrn.fdl.copperGoatHorn.currentPitch >= copperGoatHorn.minHarmonyPitch satyrn.fdl.internal run {
                execute unless items entity @s <%a0%> *[minecraft:instrument="foxcraft_dungeon_loot:<%a1%>_harmony"] run item modify entity @s <%a0%> foxcraft_dungeon_loot:copper_horn/<%a1%>_harmony
            } else run {
                execute unless items entity @s <%a0%> *[minecraft:instrument="foxcraft_dungeon_loot:<%a1%>_melody"] run item modify entity @s <%a0%> foxcraft_dungeon_loot:copper_horn/<%a1%>_melody
            }
        }
    }
}
