import ../../config.js
import ../../macros.mcbt

# Pulls a recipe from the index.
template get_offer_from_index {
    with a0:word {
        data modify storage foxcraft_dungeon_loot:trades Current set from storage foxcraft_dungeon_loot:trades Index[<%a0%>]
    }
}

# Sets the current recipe's sell item from a loot table
template set_sell_from_loot {
    with a0:word {
        loot spawn ~ ~ ~ loot <%a0%>
        execute as @e[tag=!satyrn.fdl.trades.item,type=minecraft:item,limit=1,sort=nearest] at @s run function foxcraft_dungeon_loot:trading/recipes/set_sell_from_item
    }
}

# Sets the current recipe's buy item from a loot table
template set_buy_from_loot {
    with a0:word {
        loot spawn ~ ~ ~ loot <%a0%>
        execute as @e[tag=!satyrn.fdl.trades.item,type=minecraft:item,limit=1,sort=nearest] at @s run function foxcraft_dungeon_loot:trading/recipes/set_buy_from_item
    }
}

# Sets the current recipe's secondary buy item from a loot table
template set_buyb_from_loot {
    with a0:word {
        loot spawn ~ ~ ~ loot <%a0%>
        execute as @e[tag=!satyrn.fdl.trades.item,type=minecraft:item,limit=1,sort=nearest] at @s run function foxcraft_dungeon_loot:trading/recipes/set_buyb_from_item
    }
}

template set_sell_item_id {
    with a0:word {
        data modify storage foxcraft_dungeon_loot:trades Current.sell.id set value <%a0%>
    }
}

template set_buy_item_id {
    with a0:word {
        data modify storage foxcraft_dungeon_loot:trades Current.buy.id set value <%a0%>
    }
}

template set_buyb_item_id {
    with a0:word {
        data modify storage foxcraft_dungeon_loot:trades Current.buyB.id set value <%a0%>
    }
}

# Sets the current recipe's max uses to a constant value
template set_max_uses {
    with a0:word {
        data modify storage foxcraft_dungeon_loot:trades Current.maxUses set value <%a0%>
    }
}

# Sets the current recipe's buy item count to a constant value
template set_buy_price {
    with a0:word {
        data modify storage foxcraft_dungeon_loot:trades Current.buy.count set value <%a0%>
    }
}

# Sets the current recipe's secondary buy item count to a constant value
template set_buyb_price {
    with a0:word {
        data modify storage foxcraft_dungeon_loot:trades Current.buyB.count set value <%a0%>
    }
}

# Sets the current recipe's item count per sale to a constant value
template set_sell_count {
    with a0:word {
        data modify storage foxcraft_dungeon_loot:trades Current.sell.count set value <%a0%>
    }
}

# Sets the current recipe's max uses to a random value
template randomize_max_uses {
    with a0:word a1:word {
        rng <%a0%> <%a1%>
        execute store result storage foxcraft_dungeon_loot:trades Current.maxUses int 1 run scoreboard players get #math.result <%config.internalScoreboard%>
    }
}

# Sets the current recipe's buy item count to a random value
template randomize_buy_price {
    with a0:word a1:word {
        # Set price
        rng <%a0%> <%a1%>
        execute store result storage foxcraft_dungeon_loot:trades Current.buy.count int 1 run scoreboard players get #math.result <%config.internalScoreboard%>
    }
}

# Sets the current recipe's secondary buy item count to a random value
template randomize_buyb_price {
    with a0:word a1:word {
        # Set price
        rng <%a0%> <%a1%>
        execute store result storage foxcraft_dungeon_loot:trades Current.buyB.count int 1 run scoreboard players get #math.result <%config.internalScoreboard%>
    }
}

# Sets the current recipe's item count per sale to a random value
template randomize_sell_count {
    with a0:word a1:word {
        # Set price
        rng <%a0%> <%a1%>
        execute store result storage foxcraft_dungeon_loot:trades Current.sell.count int 1 run scoreboard players get #math.result <%config.internalScoreboard%>
    }
}
