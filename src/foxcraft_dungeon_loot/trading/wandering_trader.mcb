import ../../config.js
import ../../macros.mcbt
import template.mcbt

function on_load {
    scoreboard objectives add satyrn.fdl.tradesToAdd.grabBag dummy
    scoreboard objectives add satyrn.fdl.tradesAdded.grabBag dummy
    scoreboard objectives add satyrn.fdl.tradesToAdd.head dummy
    scoreboard objectives add satyrn.fdl.tradesAdded.head dummy
    scoreboard objectives add satyrn.fdl.tradesToAdd.dungeonLoot dummy
    scoreboard objectives add satyrn.fdl.tradesAdded.dungeonLoot dummy
    scoreboard objectives add satyrn.fdl.tradesToAdd.endgame dummy
    scoreboard objectives add satyrn.fdl.tradesAdded.endgame dummy
    scoreboard objectives add satyrn.fdl.tradesToAdd.exchange dummy
    scoreboard objectives add satyrn.fdl.tradesAdded.exchange dummy
    scoreboard objectives add satyrn.fdl.tradesToAdd.goatHorns dummy
    scoreboard objectives add satyrn.fdl.tradesAdded.goatHorns dummy
    scoreboard objectives add satyrn.fdl.tradesToAdd.discs dummy
    scoreboard objectives add satyrn.fdl.tradesAdded.discs dummy
    scoreboard objectives add satyrn.fdl.selectedTrade dummy

    team add satyrn.fdl.traders "Wandering Traders"
    team modify satyrn.fdl.traders color dark_aqua
}

# Multi-tick function, adds trades to the wandering trader.
function on_tick {
    execute if entity @s[tag=!satyrn.fdl.wanderingTrader.initialized] run {
        tag @s add satyrn.fdl.wanderingTrader.initialized
        # Only traders with a DespawnDelay get custom trades, so spawners and eggs do not (#124). A /summon leaves it at 0,
        # so a dev build accepts 0 as well, otherwise a test trader never gets its lists.
        execute store result score #test <%config.internalScoreboard%> run data get entity @s DespawnDelay

        execute if score #test <%config.internalScoreboard%> matches <%config.dev?0:1%>.. run {
            data merge entity @s {NoAI:1b,NoGravity:1b,DeathLootTable:"foxcraft_dungeon_loot:entity/wandering_trader"}

            # Since 26.3 an entity only saves Offers it already has, and the vanilla trades are only generated on the first
            #  right-click. Writing Offers now would replace them, so the custom recipes wait in an inert body slot item and
            #  are merged in by on_interact after vanilla has made its own.
            tag @s add satyrn.fdl.trades.staged
            data merge entity @s {drop_chances:{body:0f},equipment:{body:{id:"minecraft:snowball",count:1,components:{"minecraft:custom_data":{StagedTrades:[]}}}}}

            execute as @e[type=minecraft:trader_llama,limit=2,sort=nearest,tag=!satyrn.fdl.wanderingTrader.llama,distance=..10] run {
                tag @s add satyrn.fdl.wanderingTrader.llama
                data merge entity @s {NoAI:1b,NoGravity:1b}
            }

            summon minecraft:armor_stand ~ ~ ~ {Invisible:<%config.dev?0:1%>b,Marker:1b,NoGravity:1b,Tags:[satyrn.fdl.wanderingTrader.tradeIndex],equipment:{mainhand:{id:"minecraft:snowball",count:1,components:{"minecraft:custom_data":{AddedTrades:[],ScanTrades:[],CurrentTrade:0}}}}}

            rng 4 5
            scoreboard players operation @s satyrn.fdl.tradesToAdd.grabBag = #math.result <%config.internalScoreboard%>
            IF (config.dev) {
                scoreboard players set @s satyrn.fdl.tradesToAdd.grabBag 5
            }


            rng 2 3
            scoreboard players operation @s satyrn.fdl.tradesToAdd.head = #math.result <%config.internalScoreboard%>
            IF (config.dev) {
                scoreboard players set @s satyrn.fdl.tradesToAdd.head 3
            }

            rng 0 2
            scoreboard players operation @s satyrn.fdl.tradesToAdd.dungeonLoot = #math.result <%config.internalScoreboard%>
            IF (config.dev) {
                scoreboard players set @s satyrn.fdl.tradesToAdd.dungeonLoot 2
            }

            rng 6 7
            scoreboard players operation @s satyrn.fdl.tradesToAdd.exchange = #math.result <%config.internalScoreboard%>
            IF (config.dev) {
                scoreboard players set @s satyrn.fdl.tradesToAdd.exchange 7
            }

            rng 0 3
            scoreboard players operation @s satyrn.fdl.tradesToAdd.goatHorns = #math.result <%config.internalScoreboard%>
            IF (config.dev) {
                scoreboard players set @s satyrn.fdl.tradesToAdd.goatHorns 3
            }

            rng 0 2
            scoreboard players operation @s satyrn.fdl.tradesToAdd.endgame = #math.result <%config.internalScoreboard%>
            IF (config.dev) {
                scoreboard players set @s satyrn.fdl.tradesToAdd.endgame 2
            }

            rng 0 2
            scoreboard players operation @s satyrn.fdl.tradesToAdd.discs = #math.result <%config.internalScoreboard%>
            IF (config.dev) {
                scoreboard players set @s satyrn.fdl.tradesToAdd.discs 2
            }

        } else run {
            tag @s add satyrn.fdl.trades.hasTrades.head
            tag @s add satyrn.fdl.trades.hasTrades.goatHorns
            tag @s add satyrn.fdl.trades.hasTrades.grabBag
            tag @s add satyrn.fdl.trades.hasTrades.dungeonLoot
            tag @s add satyrn.fdl.trades.hasTrades.exchange
            tag @s add satyrn.fdl.trades.hasTrades.endgame
            tag @s add satyrn.fdl.trades.hasTrades.discs
            tag @s add satyrn.fdl.trades.hasTrades
        }
    }

    # Isabel 2022/10/04:
    #  So this is kind of annoying, but trade generation must use 1-indexed values instead of zero-indexed values, unless the
    #  function increments satyrn.fdl.selectedTrade after assigning it (exchange rates, grab bags).
    #  Just set the randomizer to 1-index values, as it's one argument less than incrementing the scoreboard immediately
    #  afterwards.

# Exchange Loot Trades
    execute if entity @s[tag=!satyrn.fdl.trades.hasTrades.exchange] run {
        execute if score @s satyrn.fdl.tradesAdded.exchange >= @s satyrn.fdl.tradesToAdd.exchange run {
            tag @s add satyrn.fdl.trades.hasTrades.exchange
        } else run {
            # Section separator, once, when this section has trades to add
            execute unless entity @s[tag=satyrn.fdl.trades.separator.exchange] run {
                tag @s add satyrn.fdl.trades.separator.exchange
                scoreboard players set @s satyrn.fdl.selectedTrade 172
                function foxcraft_dungeon_loot:trading/wandering_trader/add_trade
            }
            execute unless score @s satyrn.fdl.tradesAdded.exchange matches 0.. run scoreboard players set @s satyrn.fdl.selectedTrade 21
            # Increments trades to add by one each time
            scoreboard players add @s satyrn.fdl.selectedTrade 1
            function foxcraft_dungeon_loot:trading/wandering_trader/add_trade
            scoreboard players add @s satyrn.fdl.tradesAdded.exchange 1
        }
# Head trades
    } else execute if entity @s[tag=!satyrn.fdl.trades.hasTrades.head] run {
        execute if score @s satyrn.fdl.tradesAdded.head >= @s satyrn.fdl.tradesToAdd.head run {
            tag @s add satyrn.fdl.trades.hasTrades.head
        } else run {
            # Section separator, once, when this section has trades to add
            execute unless entity @s[tag=satyrn.fdl.trades.separator.head] run {
                tag @s add satyrn.fdl.trades.separator.head
                scoreboard players set @s satyrn.fdl.selectedTrade 173
                function foxcraft_dungeon_loot:trading/wandering_trader/add_trade
            }
            tag @s remove satyrn.fdl.tradeAdded

            rng 6 21
            scoreboard players operation @s satyrn.fdl.selectedTrade = #math.result <%config.internalScoreboard%>

            execute as @e[type=minecraft:armor_stand,tag=satyrn.fdl.wanderingTrader.tradeIndex,sort=nearest,limit=1] run function foxcraft_dungeon_loot:trading/wandering_trader/check_existing_trades

            execute if entity @s[tag=satyrn.fdl.tradeAdded] run {
                function foxcraft_dungeon_loot:trading/wandering_trader/append_current_trade_to_index
                function foxcraft_dungeon_loot:trading/wandering_trader/add_trade
                scoreboard players add @s satyrn.fdl.tradesAdded.head 1
            }
        }
# Disc Trades
    } else execute if entity @s[tag=!satyrn.fdl.trades.hasTrades.discs] run {
        execute if score @s satyrn.fdl.tradesToAdd.discs matches 0 run {
            tag @s add satyrn.fdl.trades.hasTrades.discs
        } else execute if score @s satyrn.fdl.tradesAdded.discs >= @s satyrn.fdl.tradesToAdd.discs run {
            tag @s add satyrn.fdl.trades.hasTrades.discs
        } else run {
            # Section separator, once, when this section has trades to add
            execute unless entity @s[tag=satyrn.fdl.trades.separator.discs] run {
                tag @s add satyrn.fdl.trades.separator.discs
                scoreboard players set @s satyrn.fdl.selectedTrade 174
                function foxcraft_dungeon_loot:trading/wandering_trader/add_trade
            }
            tag @s remove satyrn.fdl.tradeAdded

            # Remember: These are 1-indexed, not 0-indexed, due to the search function
            rng 99 171
            scoreboard players operation @s satyrn.fdl.selectedTrade = #math.result <%config.internalScoreboard%>

            execute as @e[type=minecraft:armor_stand,tag=satyrn.fdl.wanderingTrader.tradeIndex,sort=nearest,limit=1] run function foxcraft_dungeon_loot:trading/wandering_trader/check_existing_trades

            execute if entity @s[tag=satyrn.fdl.tradeAdded] run {
                function foxcraft_dungeon_loot:trading/wandering_trader/append_current_trade_to_index
                function foxcraft_dungeon_loot:trading/wandering_trader/add_trade
                scoreboard players add @s satyrn.fdl.tradesAdded.discs 1
            }
        }
# Goat Horns
    } else execute unless entity @s[tag=satyrn.fdl.trades.hasTrades.goatHorns] run {
        execute if score @s satyrn.fdl.tradesToAdd.goatHorns matches 0 run {
            tag @s add satyrn.fdl.trades.hasTrades.goatHorns
        } else execute if score @s satyrn.fdl.tradesAdded.goatHorns >= @s satyrn.fdl.tradesToAdd.goatHorns run {
            tag @s add satyrn.fdl.trades.hasTrades.goatHorns
        } else run {
            # Section separator, once, when this section has trades to add
            execute unless entity @s[tag=satyrn.fdl.trades.separator.goatHorns] run {
                tag @s add satyrn.fdl.trades.separator.goatHorns
                scoreboard players set @s satyrn.fdl.selectedTrade 175
                function foxcraft_dungeon_loot:trading/wandering_trader/add_trade
            }
            tag @s remove satyrn.fdl.tradeAdded

            rng 84 93
            scoreboard players operation @s satyrn.fdl.selectedTrade = #math.result <%config.internalScoreboard%>

            execute as @e[type=minecraft:armor_stand,tag=satyrn.fdl.wanderingTrader.tradeIndex,sort=nearest,limit=1] run function foxcraft_dungeon_loot:trading/wandering_trader/check_existing_trades

            execute if entity @s[tag=satyrn.fdl.tradeAdded] run {
                function foxcraft_dungeon_loot:trading/wandering_trader/append_current_trade_to_index
                function foxcraft_dungeon_loot:trading/wandering_trader/add_trade
                scoreboard players add @s satyrn.fdl.tradesAdded.goatHorns 1
            }
        }
# Grab Bag trades
    } else execute if entity @s[tag=!satyrn.fdl.trades.hasTrades.grabBag] run {
        execute if score @s satyrn.fdl.tradesAdded.grabBag >= @s satyrn.fdl.tradesToAdd.grabBag run {
            tag @s add satyrn.fdl.trades.hasTrades.grabBag
        } else run {
            # Section separator, once, when this section has trades to add
            execute unless entity @s[tag=satyrn.fdl.trades.separator.grabBag] run {
                tag @s add satyrn.fdl.trades.separator.grabBag
                scoreboard players set @s satyrn.fdl.selectedTrade 176
                function foxcraft_dungeon_loot:trading/wandering_trader/add_trade
            }
            execute unless score @s satyrn.fdl.tradesAdded.grabBag matches 0.. run scoreboard players set @s satyrn.fdl.selectedTrade 0
            # Increments trades to add by one each time
            scoreboard players add @s satyrn.fdl.selectedTrade 1

            function foxcraft_dungeon_loot:trading/wandering_trader/add_trade

            scoreboard players add @s satyrn.fdl.tradesAdded.grabBag 1
        }
# Dungeon Loot Trades
    } else execute if entity @s[tag=!satyrn.fdl.trades.hasTrades.dungeonLoot] run {
        execute if score @s satyrn.fdl.tradesToAdd.dungeonLoot matches 0 run {
            tag @s add satyrn.fdl.trades.hasTrades.dungeonLoot
        } else execute if score @s satyrn.fdl.tradesAdded.dungeonLoot >= @s satyrn.fdl.tradesToAdd.dungeonLoot run {
            tag @s add satyrn.fdl.trades.hasTrades.dungeonLoot
        } else run {
            # Section separator, once, when this section has trades to add
            execute unless entity @s[tag=satyrn.fdl.trades.separator.dungeonLoot] run {
                tag @s add satyrn.fdl.trades.separator.dungeonLoot
                scoreboard players set @s satyrn.fdl.selectedTrade 177
                function foxcraft_dungeon_loot:trading/wandering_trader/add_trade
            }
            tag @s remove satyrn.fdl.tradeAdded

            execute unless score @s satyrn.fdl.tradesAdded.dungeonLoot matches 1.. run {
                rng 63 83
            } else run {
                rng 29 62
            }
            scoreboard players operation @s satyrn.fdl.selectedTrade = #math.result <%config.internalScoreboard%>

            execute as @e[type=minecraft:armor_stand,tag=satyrn.fdl.wanderingTrader.tradeIndex,sort=nearest,limit=1] run function foxcraft_dungeon_loot:trading/wandering_trader/check_existing_trades

            execute if entity @s[tag=satyrn.fdl.tradeAdded] run {
                function foxcraft_dungeon_loot:trading/wandering_trader/append_current_trade_to_index
                function foxcraft_dungeon_loot:trading/wandering_trader/add_trade
                scoreboard players add @s satyrn.fdl.tradesAdded.dungeonLoot 1
            }
        }
# Endgame Item Trades
    } else execute if entity @s[tag=!satyrn.fdl.trades.hasTrades.endgame] run {
        execute if score @s satyrn.fdl.tradesToAdd.endgame matches 0 run {
            tag @s add satyrn.fdl.trades.hasTrades.endgame
        } else execute if score @s satyrn.fdl.tradesAdded.endgame >= @s satyrn.fdl.tradesToAdd.endgame run {
            tag @s add satyrn.fdl.trades.hasTrades.endgame
        } else run {
            # Section separator, once, when this section has trades to add
            execute unless entity @s[tag=satyrn.fdl.trades.separator.endgame] run {
                tag @s add satyrn.fdl.trades.separator.endgame
                scoreboard players set @s satyrn.fdl.selectedTrade 178
                function foxcraft_dungeon_loot:trading/wandering_trader/add_trade
            }
            tag @s remove satyrn.fdl.tradeAdded

            # Remember: These are 1-indexed, not 0-indexed, due to the search function
            rng 94 98
            scoreboard players operation @s satyrn.fdl.selectedTrade = #math.result <%config.internalScoreboard%>

            execute as @e[type=minecraft:armor_stand,tag=satyrn.fdl.wanderingTrader.tradeIndex,sort=nearest,limit=1] run function foxcraft_dungeon_loot:trading/wandering_trader/check_existing_trades

            execute if entity @s[tag=satyrn.fdl.tradeAdded] run {
                function foxcraft_dungeon_loot:trading/wandering_trader/append_current_trade_to_index
                function foxcraft_dungeon_loot:trading/wandering_trader/add_trade
                scoreboard players add @s satyrn.fdl.tradesAdded.endgame 1
        }
    }
# Finalize entity
    # Finalize the entity, cleaning up the tracker armor stand, etc. Since we don't enter this
    #   function after this tag is sent, should only be called once.
    } else execute if entity @s[tag=!satyrn.fdl.trades.hasTrades] run {
        tag @s add satyrn.fdl.trades.hasTrades

        kill @e[tag=satyrn.fdl.wanderingTrader.tradeIndex,limit=1,sort=nearest]

        data merge entity @s {NoAI:0b,NoGravity:0b}

        scoreboard players reset @s

        execute as @e[tag=satyrn.fdl.wanderingTrader.llama,limit=2,sort=nearest,distance=..10] run {
            tag @s remove satyrn.fdl.wanderingTrader.llama
            data merge entity @s {NoAI:0b,NoGravity:0b}
            data modify entity @s leash set from entity @e[type=minecraft:wandering_trader,limit=1,sort=nearest,distance=..5] UUID
            data modify entity @s Owner set from entity @e[type=minecraft:wandering_trader,limit=1,sort=nearest,distance=..5] UUID
        }

        execute if score trader.enableWelcomeMsg <%config.internalScoreboard%> matches 1 run {
            team join satyrn.fdl.traders @s

            execute store result score #x <%config.internalScoreboard%> run data get entity @s Pos[0]
            execute store result score #z <%config.internalScoreboard%> run data get entity @s Pos[2]

            effect give @s minecraft:glowing 10

            tag @s add satyrn.fdl.wanderingTrader.announce
            tellraw @a ["[",{"selector":"@s"},"] Hello! I offer exotic wares at fair prices. Find me near ",{"selector":"@p"},", at ",{"score":{"name":"#x","objective":"<%config.internalScoreboard%>"}},"x ",{"score":{"name":"#z","objective":"<%config.internalScoreboard%>"}},"z!"]
            execute as @a at @s facing entity @e[type=minecraft:wandering_trader,limit=1,tag=satyrn.fdl.wanderingTrader.announce] eyes run playsound minecraft:entity.wandering_trader.yes neutral @s ^ ^ ^1
            tag @s remove satyrn.fdl.wanderingTrader.announce
        }
    }
}

function on_uninstall {
    scoreboard objectives remove satyrn.fdl.tradesToAdd.grabBag
    scoreboard objectives remove satyrn.fdl.tradesAdded.grabBag
    scoreboard objectives remove satyrn.fdl.tradesToAdd.head
    scoreboard objectives remove satyrn.fdl.tradesAdded.head
    scoreboard objectives remove satyrn.fdl.tradesToAdd.dungeonLoot
    scoreboard objectives remove satyrn.fdl.tradesAdded.dungeonLoot
    scoreboard objectives remove satyrn.fdl.selectedTrade
    scoreboard objectives remove satyrn.fdl.tradesToAdd.exchange
    scoreboard objectives remove satyrn.fdl.tradesAdded.exchange
    scoreboard objectives remove satyrn.fdl.tradesToAdd.goatHorns
    scoreboard objectives remove satyrn.fdl.tradesAdded.goatHorns
    scoreboard objectives remove satyrn.fdl.tradesToAdd.endgame
    scoreboard objectives remove satyrn.fdl.tradesAdded.endgame
    scoreboard objectives remove satyrn.fdl.tradesToAdd.discs
    scoreboard objectives remove satyrn.fdl.tradesAdded.discs

    team remove satyrn.fdl.traders
}

function append_current_trade_to_index {
    execute as @e[tag=satyrn.fdl.wanderingTrader.tradeIndex,limit=1,sort=nearest] run {
        execute store result entity @s equipment.mainhand.components."minecraft:custom_data".CurrentTrade int 1 run scoreboard players get @e[type=minecraft:wandering_trader,sort=nearest,limit=1] satyrn.fdl.selectedTrade
        data modify entity @s equipment.mainhand.components."minecraft:custom_data".AddedTrades append from entity @s equipment.mainhand.components."minecraft:custom_data".CurrentTrade
    }
}

function check_existing_trades {
    data modify entity @s equipment.mainhand.components."minecraft:custom_data".ScanTrades set from entity @s equipment.mainhand.components."minecraft:custom_data".AddedTrades

    function foxcraft_dungeon_loot:trading/wandering_trader/recursive_check

    execute if score @s satyrn.fdl.selectedTrade matches 0 run tag @e[type=minecraft:wandering_trader,sort=nearest,limit=1] add satyrn.fdl.tradeAdded
}

function recursive_check {
    # The recursive check continues if the trade number is zero, so satyrn.fdl.selectedTrade must be 1-indexed.
    execute store result score @s satyrn.fdl.selectedTrade run data get entity @s equipment.mainhand.components."minecraft:custom_data".ScanTrades[0]

    execute if score @e[type=minecraft:wandering_trader,sort=nearest,limit=1] satyrn.fdl.selectedTrade = @s satyrn.fdl.selectedTrade run scoreboard players set @s satyrn.fdl.selectedTrade -127

    data remove entity @s equipment.mainhand.components."minecraft:custom_data".ScanTrades[0]

    execute if score @s satyrn.fdl.selectedTrade matches 1.. run function foxcraft_dungeon_loot:trading/wandering_trader/recursive_check
}

function add_trade {
    # i value should loop through entire size of the trade index
    REPEAT(0, 177) as i {
        # i values are zero indexed but selectedTrade is 1-indexed. Add 1 to i in the check.
        execute if score @s satyrn.fdl.selectedTrade matches <%i+1%> run {
            get_offer_from_index <%i%>

            # Grab-Bag randomized pricing
            IF (i==0) {
                randomize_max_uses 3 5
                randomize_buy_price 1 3
                randomize_buyb_price 0 9
            }

            # Glistering Grab-Bag randomized pricing
            IF (i==1) {
                randomize_max_uses 2 4
                randomize_buy_price 4 6
                randomize_buyb_price 0 9
            }

            # Sparkling Grab-Bag randomized pricing
            IF (i==2) {
                randomize_max_uses 1 3
                randomize_buy_price 7 9
                randomize_buyb_price 0 9
            }

            # Shining Grab-Bag randomized pricing
            IF (i==3) {
                randomize_max_uses 1 2
                randomize_buy_price 1 4
                randomize_buyb_price 0 9
            }

            # Radiant Grab-Bag randomized pricing
            IF (i==4) {
                randomize_buy_price 5 9
                randomize_buyb_price 0 9
            }

            # Player heads randomized pricing
            IF (i>=5 && i<=20) {
                randomize_buy_price 1 9
            }

            # Randomize electrum value per silver
            IF (i==27) {
                randomize_sell_count 1 10
            }

            # Mythic item random pricing
            IF (i>=28 && i<=61) {
                randomize_buyb_price 0 9
            }

            # Epic item random pricing
            IF (i>=62 && i<=82) {
                randomize_buy_price 1 9
                randomize_buyb_price 0 9
            }

            # Goat horn random pricing / exchange
            IF (i>=83 && i<=92) {
                randomize_buy_price 1 3
                set_buyb_from_loot foxcraft_dungeon_loot:item/special/copper_horn/random_goat_horn
            }

            # Platinum coins for endgame items
            IF (i==93 || i==96) {
                randomize_buy_price 2 10
                randomize_buyb_price 0 9
            }
            IF (i==94 || i==95 || i==97) {
                randomize_max_uses 1 5
                randomize_buy_price 1 2
                randomize_buyb_price 0 9
            }
            IF (i==95) {
                randomize_sell_count 1 4
            }
            IF (i==97) {
                randomize_sell_count 1 10
            }

            # Discs, paid in gold coins
            IF (i>=98 && i<=170) {
                randomize_buy_price 2 10
            }
        }
    }

    # Stage the constructed recipe, on_interact moves it into Offers.
    data modify entity @s equipment.body.components."minecraft:custom_data".StagedTrades append from storage foxcraft_dungeon_loot:trades Current
}

# Rewarded by advancement trading/on_interact after a player right-clicks a finished trader that still has staged recipes.
# Vanilla has generated its own offers by then, so the custom ones are added after them. The open trading screen holds the
# old list and a screen cannot be refreshed, so it is closed by moving the trader out of interaction range for a tick.
function on_interact {
    advancement revoke @s only foxcraft_dungeon_loot:trading/on_interact

    # Greeted by return_trader once the trader is back down
    tag @s add satyrn.fdl.trades.greet

    execute as @e[type=minecraft:wandering_trader,tag=satyrn.fdl.trades.staged,tag=satyrn.fdl.trades.hasTrades,distance=..8,sort=nearest,limit=1] at @s run function foxcraft_dungeon_loot:trading/wandering_trader/merge_staged
}

function merge_staged {
    data modify entity @s Offers.Recipes append from entity @s equipment.body.components."minecraft:custom_data".StagedTrades[]
    data remove entity @s equipment.body
    tag @s remove satyrn.fdl.trades.staged

    tag @s add satyrn.fdl.trades.returning
    data merge entity @s {NoGravity:1b}
    tp @s ~ ~12 ~

    # Leashed llamas go along by the same offset, otherwise the leads stretch past their limit and break.
    execute as @e[type=minecraft:trader_llama,distance=..16] at @s run {
        tag @s add satyrn.fdl.trades.returning
        data merge entity @s {NoGravity:1b}
        tp @s ~ ~12 ~
    }
    schedule function foxcraft_dungeon_loot:trading/wandering_trader/return_trader 1t
}

function return_trader {
    execute as @e[tag=satyrn.fdl.trades.returning] at @s run {
        tp @s ~ ~-12 ~
        data merge entity @s {NoGravity:0b}
        tag @s remove satyrn.fdl.trades.returning

        # Same format as the welcome message, the trader is the selector. Llamas have nothing to say.
        execute if entity @s[type=minecraft:wandering_trader] run {
            tellraw @p[tag=satyrn.fdl.trades.greet] ["[",{"selector":"@s"},"] Ah, ",{"selector":"@p[tag=satyrn.fdl.trades.greet]"},", welcome! I have some interesting things for you... if you've got the coin, that is!"]
            execute as @p[tag=satyrn.fdl.trades.greet] at @s run playsound minecraft:entity.wandering_trader.yes neutral @s ~ ~ ~
        }
    }

    tag @a remove satyrn.fdl.trades.greet
}
