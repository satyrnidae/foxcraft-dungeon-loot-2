        set_sell_from_loot foxcraft_dungeon_loot:item/random_loot/player_head/analogouspants5_head
        set_buy_from_loot foxcraft_dungeon_loot:item/random_loot/coin/copper_coins
        set_buyb_item_id "minecraft:air"
        set_max_uses 3
        function foxcraft_dungeon_loot:trading/recipes/push

