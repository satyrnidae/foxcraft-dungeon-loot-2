import ../../config.js
import template.mcbt

function on_load {
    execute in minecraft:the_end run forceload add 264 264
    schedule function foxcraft_dungeon_loot:trading/index/wait_for_chunk 1t
}

function on_uninstall {
    data remove storage foxcraft_dungeon_loot:trades Index
    data remove storage foxcraft_dungeon_loot:trades Current
}

function wait_for_chunk {
    execute in minecraft:the_end positioned 264 64 264 run {
        summon minecraft:marker ~ ~ ~ {Tags:[satyrn.fdl.trade.index.chunkTest]}
        execute unless entity @e[type=minecraft:marker,tag=satyrn.fdl.trade.index.chunkTest,distance=..0.5] run {
            schedule function foxcraft_dungeon_loot:trading/index/wait_for_chunk 1s
        } else run {
            kill @e[type=minecraft:marker,tag=satyrn.fdl.trade.index.chunkTest]
            schedule function foxcraft_dungeon_loot:trading/index/build 1t
        }
    }
}

function build {
    data modify storage foxcraft_dungeon_loot:trades Version set value "<%config.version%>"
    data modify storage foxcraft_dungeon_loot:trades Index set value []
    data modify storage foxcraft_dungeon_loot:trades Current set value {}

    execute in minecraft:the_end positioned 264 64 264 run {
        tellraw @a {"text":"Building trade index...","color":"gray"}

# Grab Bags 0-4
        # Trade Index 0: Grab-Bag
        function foxcraft_dungeon_loot:trading/recipes/new
        set_sell_from_loot foxcraft_dungeon_loot:item/common/common_grab_bag
        set_buy_from_loot foxcraft_dungeon_loot:item/random_loot/coin/silver_coins
        set_buyb_from_loot foxcraft_dungeon_loot:item/random_loot/coin/copper_coins
        function foxcraft_dungeon_loot:trading/recipes/push

        # Trade Index 1: Glistering Grab-Bag
        set_sell_from_loot foxcraft_dungeon_loot:item/uncommon/uncommon_grab_bag
        function foxcraft_dungeon_loot:trading/recipes/push

        # Trade Index 2: Sparkling Grab-Bag
        set_sell_from_loot foxcraft_dungeon_loot:item/rare/rare_grab_bag
        function foxcraft_dungeon_loot:trading/recipes/push

        # Trade Index 3: Shining Grab-Bag
        set_sell_from_loot foxcraft_dungeon_loot:item/epic/epic_grab_bag
        set_buy_from_loot foxcraft_dungeon_loot:item/random_loot/coin/gold_coins
        set_buyb_from_loot foxcraft_dungeon_loot:item/random_loot/coin/silver_coins
        set_buy_price 1
        function foxcraft_dungeon_loot:trading/recipes/push

        # Trade Index 4: Shining Grab-Bag
        set_sell_from_loot foxcraft_dungeon_loot:item/mythic/mythic_grab_bag
        set_max_uses 1
        function foxcraft_dungeon_loot:trading/recipes/push

# Heads 5-20
