import ../../../config.js
import ../../../macros.mcbt

# Relevant Entity Tags:
# satyrn.fdl.xNoEvil.heldItem - A player that is holding the X No Evil item
# satyrn.fdl.xNoEvil.projectile - The snowball thrown by a player who used X No Evil
# satyrn.fdl.xNoEvil.projectileTracker - A marker teleported onto the projectile every tick. Its data.Owner saves the throwing player's UUID.
# satyrn.fdl.xNoEvil.areaOfEffect - The area of effect cloud created by the projectile.

function on_snowball_used {
    # Execute if a tagged player threw a snowball.
    execute if entity @s[tag=satyrn.fdl.xNoEvil.heldItem] run {
        # Execute the following as the nearest snowball, presumably the one thrown by the player.
        execute as @e[type=minecraft:snowball,limit=1,sort=nearest] at @s run {
            # Tag the snowball as the projectile.
            tag @s add satyrn.fdl.xNoEvil.projectile

            # Summon a tracker marker and remember the thrower on it.
            summon minecraft:marker ~ ~ ~ {Tags:[satyrn.fdl.xNoEvil.projectileTracker],data:{Owner:[I;0,0,0,0]}}
            data modify entity @e[tag=satyrn.fdl.xNoEvil.projectileTracker,limit=1,sort=nearest] data.Owner set from entity @s Owner
        }
    }
}

# Occurs once per player per tick.
function on_tick {
    # A tag is added to the player while they are holding X No Evil and is cleared from any player not holding X No Evil.
    execute as @a[predicate=!foxcraft_dungeon_loot:item/mythic/x_no_evil/in_main_hand,predicate=!foxcraft_dungeon_loot:item/mythic/x_no_evil/in_off_hand] run tag @s remove satyrn.fdl.xNoEvil.heldItem

    execute as @a[predicate=foxcraft_dungeon_loot:entity/inventory/is_mainhand_snowball,predicate=!foxcraft_dungeon_loot:item/mythic/x_no_evil/in_main_hand] run tag @s remove satyrn.fdl.xNoEvil.heldItem

    execute as @a[predicate=foxcraft_dungeon_loot:item/mythic/x_no_evil/in_main_hand] run tag @s add satyrn.fdl.xNoEvil.heldItem

    execute as @a[predicate=!foxcraft_dungeon_loot:entity/inventory/is_mainhand_snowball,predicate=foxcraft_dungeon_loot:item/mythic/x_no_evil/in_off_hand] run tag @s add satyrn.fdl.xNoEvil.heldItem

    execute as @e[tag=satyrn.fdl.xNoEvil.projectileTracker] at @s run {
        # If the tracker is near a projectile, move onto it. A snowball covers up to 1.5 blocks a tick, so look wider than one.
        execute if entity @e[tag=satyrn.fdl.xNoEvil.projectile,distance=..4,limit=1,sort=nearest] run {
            tp @s @e[tag=satyrn.fdl.xNoEvil.projectile,distance=..4,limit=1,sort=nearest]
        } else run {
            # Bottle break sound and particles
            playsound minecraft:entity.splash_potion.break player @a ~ ~ ~ 1.5
            particle minecraft:item{item:{id:"minecraft:snowball",components:{"minecraft:item_model":"foxcraft_dungeon_loot:mythic/x_no_evil"}}} ^ ^ ^ 0.25 0.05 0.25 0.1 5
            particle minecraft:effect ^ ^ ^ 0.25 0.05 0.25 0.1 10

            # Randomly select an effect and summon an area effect cloud where the projectile landed.
            rng 1 10

            execute if score #math.result <%config.internalScoreboard%> matches 1 run {
                # Summon a 10-foot radius AOE for one minute of blindness
                summon minecraft:area_effect_cloud ^ ^0.1 ^ {Duration:60,potion_contents:{custom_effects:[{id:"minecraft:blindness",amplifier:0,duration:1200,show_icon:1b}]},Radius:10,Tags:[satyrn.fdl.xNoEvil.areaOfEffect],Owner:[I;0,0,0,0]}
            } else execute if score #math.result satyrn.fdl.internal matches ..3 run {
                # Summon a 10-radius AOE for 20 seconds of hunger
                summon minecraft:area_effect_cloud ^ ^0.1 ^ {Duration:60,potion_contents:{custom_effects:[{id:"minecraft:hunger",amplifier:0,duration:400,show_icon:1b}]},Radius:10,Tags:[satyrn.fdl.xNoEvil.areaOfEffect],Owner:[I;0,0,0,0]}
            } else execute if score #math.result satyrn.fdl.internal matches 4 run {
                # Summon a 10-radius AOE for 30 seconds of wither
                summon minecraft:area_effect_cloud ^ ^0.1 ^ {Duration:60,potion_contents:{custom_effects:[{id:"minecraft:wither",amplifier:0,duration:600,show_icon:1b}]},Radius:10,Tags:[satyrn.fdl.xNoEvil.areaOfEffect],Owner:[I;0,0,0,0]}
            } else execute if score #math.result satyrn.fdl.internal matches ..6 run {
                # Summon a 10-radius AOE for 3 minutes of poison
                summon minecraft:area_effect_cloud ^ ^0.1 ^ {Duration:60,potion_contents:{custom_effects:[{id:"minecraft:poison",amplifier:0,duration:3600,show_icon:1b}]},Radius:10,Tags:[satyrn.fdl.xNoEvil.areaOfEffect],Owner:[I;0,0,0,0]}
            } else execute if score #math.result satyrn.fdl.internal matches ..8 run {
                # Summon a 10-radius AOE for 60 seconds of nausea
                summon minecraft:area_effect_cloud ^ ^0.1 ^ {Duration:60,potion_contents:{custom_effects:[{id:"minecraft:nausea",amplifier:0,duration:1200,show_icon:1b}]},Radius:10,Tags:[satyrn.fdl.xNoEvil.areaOfEffect],Owner:[I;0,0,0,0]}
            } else execute if score #math.result satyrn.fdl.internal matches ..9 run {
                # Summon a 10-radius AOE for instant damage V
                summon minecraft:area_effect_cloud ^ ^0.1 ^ {Duration:60,potion_contents:{custom_effects:[{id:"minecraft:instant_damage",amplifier:3,show_icon:1b}]},Radius:10,Tags:[satyrn.fdl.xNoEvil.areaOfEffect],Owner:[I;0,0,0,0]}
            } else run {
                # Summon a 10-radius AOE for 1:30 of slowness
                summon minecraft:area_effect_cloud ^ ^0.1 ^ {Duration:60,potion_contents:{custom_effects:[{id:"minecraft:slowness",amplifier:2,duration:1800,show_icon:1b}]},Radius:10,Tags:[satyrn.fdl.xNoEvil.areaOfEffect],Owner:[I;0,0,0,0]}
            }

            # Set the area of effect's owner to the owner contained in the snowball riding the tracker
            data modify entity @e[tag=satyrn.fdl.xNoEvil.areaOfEffect,predicate=foxcraft_dungeon_loot:item/mythic/x_no_evil/is_new_aoe_cloud,limit=1,sort=nearest] Owner set from entity @s data.Owner

            # Clean up tracking entity
            kill @s
        }
    }
}

# Gives the target the x no evil.
function give_x_no_evil {
    loot give @s loot foxcraft_dungeon_loot:item/mythic/x_no_evil
}
