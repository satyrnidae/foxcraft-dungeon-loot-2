# TAGS USED
# satyrn.fdl.stompies.effectsApplies - Marks a player as having effects applied by the item.

# Occurs once per ten ticks, or once every half second.
function clock_10t {
    schedule function foxcraft_dungeon_loot:item/mythic/stompies/clock_10t 10t

    # Remove the effects from players who aren't wearing the stompies.
    execute as @a[tag=satyrn.fdl.stompies.effectsApplied,predicate=!foxcraft_dungeon_loot:item/mythic/stompies/worn] run {
        effect clear @s minecraft:jump_boost
        tag @s remove satyrn.fdl.stompies.effectsApplied
    }

    # Add the effects to players who are wearing the stompies.
    execute as @a[predicate=foxcraft_dungeon_loot:item/mythic/stompies/worn,predicate=!foxcraft_dungeon_loot:item/mythic/stompies/has_effects] run {
        effect give @s minecraft:jump_boost 1000000 1 true
        tag @s add satyrn.fdl.stompies.effectsApplied
    }
}

# Starts the clock function
function on_load {
    schedule function foxcraft_dungeon_loot:item/mythic/stompies/clock_10t 8t
}

# Gives the target the stompies.
function give_stompies {
    loot give @s loot foxcraft_dungeon_loot:item/mythic/stompies
}

# Gives the chainmail variant, loot variant score 1.
function give_stompies_chainmail {
    scoreboard players set @s satyrn.fdl.loot.variant 1
    loot give @s loot foxcraft_dungeon_loot:item/mythic/stompies
    scoreboard players reset @s satyrn.fdl.loot.variant
}

# Gives the iron variant, loot variant score 2.
function give_stompies_iron {
    scoreboard players set @s satyrn.fdl.loot.variant 2
    loot give @s loot foxcraft_dungeon_loot:item/mythic/stompies
    scoreboard players reset @s satyrn.fdl.loot.variant
}

# Gives the diamond variant, loot variant score 3.
function give_stompies_diamond {
    scoreboard players set @s satyrn.fdl.loot.variant 3
    loot give @s loot foxcraft_dungeon_loot:item/mythic/stompies
    scoreboard players reset @s satyrn.fdl.loot.variant
}

# Gives the netherite variant, loot variant score 4.
function give_stompies_netherite {
    scoreboard players set @s satyrn.fdl.loot.variant 4
    loot give @s loot foxcraft_dungeon_loot:item/mythic/stompies
    scoreboard players reset @s satyrn.fdl.loot.variant
}
