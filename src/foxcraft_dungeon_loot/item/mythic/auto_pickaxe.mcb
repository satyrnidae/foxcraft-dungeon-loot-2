# TAGS USED
# satyrn.fdl.autoPickaxe.effectsApplied - Refers to a player who has had the effects of the auto pickaxe applied to them.

# Occurs once every ten ticks
function clock_10t {
    # Schedule the function to run again in 10 ticks.
    schedule function foxcraft_dungeon_loot:item/mythic/auto_pickaxe/clock_10t 10t

    # Execute for every player holding the pickaxe in their main hand.
    execute as @a[predicate=foxcraft_dungeon_loot:item/mythic/auto_pickaxe/in_main_hand,predicate=!foxcraft_dungeon_loot:item/mythic/auto_pickaxe/has_effects] at @s run {
        effect give @s minecraft:haste 1000000 1 true
        tag @s add satyrn.fdl.autoPickaxe.effectsApplied
    }

    # Execute for every player not holding the pickaxe in their main hand, but tagged as having the pickaxe's effects.
    execute as @a[predicate=!foxcraft_dungeon_loot:item/mythic/auto_pickaxe/in_main_hand,tag=satyrn.fdl.autoPickaxe.effectsApplied] at @s run {
        effect clear @s minecraft:haste
        tag @s remove satyrn.fdl.autoPickaxe.effectsApplied
    }
}

# Occurs once as the data pack is loaded.
function on_load {
    schedule function foxcraft_dungeon_loot:item/mythic/auto_pickaxe/clock_10t 1t
}

# Gives the target the auto pickaxe.
function give_auto_pickaxe {
    loot give @s loot foxcraft_dungeon_loot:item/mythic/auto_pickaxe
}

# Gives the diamond variant, loot variant score 1.
function give_auto_pickaxe_diamond {
    scoreboard players set @s satyrn.fdl.loot.variant 1
    loot give @s loot foxcraft_dungeon_loot:item/mythic/auto_pickaxe
    scoreboard players reset @s satyrn.fdl.loot.variant
}

# Gives the netherite variant, loot variant score 2.
function give_auto_pickaxe_netherite {
    scoreboard players set @s satyrn.fdl.loot.variant 2
    loot give @s loot foxcraft_dungeon_loot:item/mythic/auto_pickaxe
    scoreboard players reset @s satyrn.fdl.loot.variant
}
