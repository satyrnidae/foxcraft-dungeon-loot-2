import ../../../config.js
import ../../../macros.mcbt

# TAGS USED
# satyrn.fdl.gravilockBoots.effectsApplied - Refers to players who have had the slowness effect from wearing gravilock boots applied.

# Clock that executes every 10 ticks.
function clock_10t {
    schedule function foxcraft_dungeon_loot:item/mythic/gravilock_boots/clock_10t 10t
    execute as @a[predicate=foxcraft_dungeon_loot:item/mythic/gravilock_boots/worn] run {
        execute at @s[predicate=foxcraft_dungeon_loot:item/mythic/gravilock_boots/has_levitation] run {
            # NBT scan is only performed when levitation effect is removed.
            execute if entity @s[predicate=foxcraft_dungeon_loot:entity/is_on_ground] run {
                playsound foxcraft_dungeon_loot:item.gravilock_boots.spark player @a
            } else run {
                playsound foxcraft_dungeon_loot:item.gravilock_boots.zap player @a ~ ~ ~ 1.0 0.5
            }
            # Spawn a particle effect at the player's feet
            particle minecraft:electric_spark ~ ~ ~ 0.1 0 0.1 0.25 5

            # NBT Scan is probably better here than in the main tick.
            execute unless entity @s[gamemode=creative] run {
                execute if entity @s[predicate=foxcraft_dungeon_loot:entity/inventory/feet_have_unbreaking] run {
                    # NBT scan to determine unbreaking level.
                    execute store result score #math.input1 <%config.internalScoreboard%> run data get entity @s Inventory[{Slot:100b}].components."minecraft:enchantments"."minecraft:unbreaking"
                    function foxcraft_dungeon_loot:math/should_damage_armor
                    execute if score #math.result <%config.internalScoreboard%> matches 1 run function foxcraft_dungeon_loot:item/mythic/gravilock_boots/damage
                } else run {
                    function foxcraft_dungeon_loot:item/mythic/gravilock_boots/damage
                }
            }
        }

        execute if entity @s[predicate=!foxcraft_dungeon_loot:item/mythic/gravilock_boots/has_effects] run {
            effect give @s minecraft:slowness 1000000 1
            tag @s add satyrn.fdl.gravilockBoots.effectsApplied
        }
    }

    execute as @a[predicate=!foxcraft_dungeon_loot:item/mythic/gravilock_boots/worn,tag=satyrn.fdl.gravilockBoots.effectsApplied] run {
        effect clear @s minecraft:slowness
        tag @s remove satyrn.fdl.gravilockBoots.effectsApplied
    }
}

function damage {
    execute if entity @s[predicate=foxcraft_dungeon_loot:item/mythic/gravilock_boots/is_iron] run {
        item modify entity @s armor.feet foxcraft_dungeon_loot:mythic/gravilock_boots/damage_iron
        execute if entity @s[predicate=foxcraft_dungeon_loot:entity/inventory/boots_broken] run {
            break_item armor.feet {id:"minecraft:iron_boots"}
        }
    } else execute if entity @s[predicate=foxcraft_dungeon_loot:item/mythic/gravilock_boots/is_diamond] run {
        item modify entity @s armor.feet foxcraft_dungeon_loot:mythic/gravilock_boots/damage_diamond
        execute if entity @s[predicate=foxcraft_dungeon_loot:entity/inventory/boots_broken] run {
            break_item armor.feet {id:"minecraft:diamond_boots"}
        }
    } else run {
        # We'll just assume this is netherite to save on NBT scans.
        item modify entity @s armor.feet foxcraft_dungeon_loot:mythic/gravilock_boots/damage_netherite
        execute if entity @s[predicate=foxcraft_dungeon_loot:entity/inventory/boots_broken] run {
            break_item armor.feet {id:"minecraft:netherite_boots"}
        }
    }
}

# Schedules the item's clock functions.
function on_load {
    schedule function foxcraft_dungeon_loot:item/mythic/gravilock_boots/clock_10t 5t
}
