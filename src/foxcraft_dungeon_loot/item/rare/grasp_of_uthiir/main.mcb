import ../../../../config.js
import ../../../../macros.mcbt
import ./constants.js

# Relevant Entity Tags:
# satyrn.fdl.grasp_of_uthiir.held_item - A player that is holding the Grasp of Uthiir
# satyrn.fdl.grasp_of_uthiir.thrower - The player who threw it while the projectile is in flight, never counts as a hit entity
# satyrn.fdl.grasp_of_uthiir.projectile - The snowball thrown by a player who used the Grasp of Uthiir
# satyrn.fdl.grasp_of_uthiir.projectile_tracker - A marker which is teleported onto the projectile every tick. It has no hitbox, so the
#   snowball cannot strike it, and it is left behind where the projectile stopped.

function on_snowball_used {
    # Execute if a tagged player threw a snowball.
    execute if entity @s[tag=satyrn.fdl.grasp_of_uthiir.held_item] run {
        tag @s add satyrn.fdl.grasp_of_uthiir.thrower
        # Execute the following as the nearest snowball, presumably the one thrown by the player.
        execute as @e[type=minecraft:snowball,limit=1,sort=nearest] at @s run {
            # Tag the snowball as the projectile.
            tag @s add satyrn.fdl.grasp_of_uthiir.projectile

            # Summon the tracker on the projectile. An armor stand was struck by the snowball and had its own physics.
            summon minecraft:marker ~ ~ ~ {Tags:[satyrn.fdl.grasp_of_uthiir.projectile_tracker]}
        }
    }
}

# Occurs once per player per tick.
function on_tick {
    # A tag is added to the player while they are holding the Grasp of Uthiir and is cleared from any player not holding it.
    execute as @a[predicate=!foxcraft_dungeon_loot:item/rare/grasp_of_uthiir/in_main_hand,predicate=!foxcraft_dungeon_loot:item/rare/grasp_of_uthiir/in_off_hand] run tag @s remove satyrn.fdl.grasp_of_uthiir.held_item

    execute as @a[predicate=foxcraft_dungeon_loot:entity/inventory/is_mainhand_snowball,predicate=!foxcraft_dungeon_loot:item/rare/grasp_of_uthiir/in_main_hand] run tag @s remove satyrn.fdl.grasp_of_uthiir.held_item

    execute as @a[predicate=foxcraft_dungeon_loot:item/rare/grasp_of_uthiir/in_main_hand] run tag @s add satyrn.fdl.grasp_of_uthiir.held_item

    execute as @a[predicate=!foxcraft_dungeon_loot:entity/inventory/is_mainhand_snowball,predicate=foxcraft_dungeon_loot:item/rare/grasp_of_uthiir/in_off_hand] run tag @s add satyrn.fdl.grasp_of_uthiir.held_item

    execute as @e[type=minecraft:marker,tag=satyrn.fdl.cobwebdecay] at @s run function foxcraft_dungeon_loot:item/rare/grasp_of_uthiir/main/decay_tick

    execute as @e[tag=satyrn.fdl.grasp_of_uthiir.projectile_tracker] at @s run {
        # If the tracker is near a projectile, move onto it. A snowball covers up to 1.5 blocks a tick, so look wider than one.
        execute if entity @e[tag=satyrn.fdl.grasp_of_uthiir.projectile,distance=..4,limit=1,sort=nearest] run {
            tp @s @e[tag=satyrn.fdl.grasp_of_uthiir.projectile,distance=..4,limit=1,sort=nearest]
        } else run {
            # A snowball that struck an entity webs the entity, otherwise the item is given back where the tracker stopped.
            # An entity's position is its feet, so a hit on the head of a tall mob is further than 2 blocks from it. Look
            # from the tracker and from 1 and 2 blocks below it.
            REPEAT(-2, 0) as y {
                execute positioned ~ ~<%y%> ~ run tag @e[type=!#foxcraft_dungeon_loot:non_living,tag=!satyrn.fdl.grasp_of_uthiir.thrower,distance=..2.5] add satyrn.fdl.grasp_of_uthiir.candidate
            }
            execute if entity @e[tag=satyrn.fdl.grasp_of_uthiir.candidate] run {
                execute as @e[tag=satyrn.fdl.grasp_of_uthiir.candidate,sort=nearest,limit=1] at @s run function foxcraft_dungeon_loot:item/rare/grasp_of_uthiir/main/hit_entity
                tag @e[tag=satyrn.fdl.grasp_of_uthiir.candidate] remove satyrn.fdl.grasp_of_uthiir.candidate
            } else run {
                loot spawn ~ ~ ~ loot foxcraft_dungeon_loot:item/rare/grasp_of_uthiir
            }

            # Clean up tracking entity
            particle minecraft:item{item:{id:"minecraft:cobweb"}} ~ ~ ~ 0.1 0.1 0.1 0.1 20
            tag @a remove satyrn.fdl.grasp_of_uthiir.thrower
            kill @s
        }
    }
}

# Runs as the struck entity. Slows it and webs every empty block its hitbox touches. align xyz plus dx=dy=dz=0 tests the
# hitbox against a single block cell, the scan covers 3x3 columns up to 3 blocks tall from the feet.
function hit_entity {
    effect give @s minecraft:slowness <%cobwebDecay%> 1
    scoreboard players set #test <%config.internalScoreboard%> 0
    REPEAT(-1, 1) as x {
        REPEAT(0, 2) as y {
            REPEAT(-1, 1) as z {
                execute positioned ~<%x%> ~<%y%> ~<%z%> align xyz if entity @s[dx=0,dy=0,dz=0] if block ~ ~ ~ #minecraft:air store success score #test <%config.internalScoreboard%> run function foxcraft_dungeon_loot:item/rare/grasp_of_uthiir/main/web_cell
            }
        }
    }
    # Nothing could be placed, give the item back
    execute if score #test <%config.internalScoreboard%> matches 0 run loot spawn ~ ~ ~ loot foxcraft_dungeon_loot:item/rare/grasp_of_uthiir
}

# Runs at the corner of an empty block in the hitbox. Places the cobweb and a marker that decays it. Returns 1 so the caller
# can tell something was placed.
function web_cell {
    setblock ~ ~ ~ minecraft:cobweb keep
    # Prototype for namespaced custom data on entities, nested under the pack id so other implementations can follow it
    summon minecraft:marker ~0.5 ~0.5 ~0.5 {Tags:[satyrn.fdl.cobwebdecay],data:{foxcraft_dungeon_loot:{cobweb_decay:<%cobwebDecay * 20%>}}}
    return 1
}

# Runs as and at a decay marker. Markers do not tick any timer, so count data.foxcraft_dungeon_loot.cobweb_decay down here.
# Gone when the cobweb was broken, along with one string from the drop, and clears the cobweb when the time runs out.
function decay_tick {
    execute if block ~ ~ ~ minecraft:cobweb run {
        execute if data entity @s data.foxcraft_dungeon_loot{cobweb_decay:1} run {
            setblock ~ ~ ~ minecraft:air
            particle minecraft:item{item:{id:"minecraft:cobweb"}} ~ ~ ~ 0.2 0.2 0.2 0.05 10
            kill @s
        } else run {
            # compute cannot read entity data, only scoreboards and storage, so stage the value in storage
            data modify storage foxcraft_dungeon_loot:items grasp_of_uthiir.cobweb_decay set from entity @s data.foxcraft_dungeon_loot.cobweb_decay
            execute store result entity @s data.foxcraft_dungeon_loot.cobweb_decay int 1 run compute default integer {type:"minecraft:sub",left:{type:"minecraft:storage",storage:"foxcraft_dungeon_loot:items",path:"grasp_of_uthiir.cobweb_decay"},right:1}
        }
    } else run {
        # Broken early, expiry never reaches here. The break drops one string within a quarter block of the cell center, so
        # take one from the nearest stack, which may have merged with other string.
        execute as @e[type=minecraft:item,distance=..1,nbt={Item:{id:"minecraft:string"}},sort=nearest,limit=1] run function foxcraft_dungeon_loot:item/rare/grasp_of_uthiir/main/remove_string
        kill @s
    }
}

# Runs as a string item stack. Removes one string, and the stack itself only when that was the last.
function remove_string {
    execute if data entity @s Item{count:1} run {
        kill @s
    } else run {
        data modify storage foxcraft_dungeon_loot:items grasp_of_uthiir.string_count set from entity @s Item.count
        execute store result entity @s Item.count int 1 run compute default integer {type:"minecraft:sub",left:{type:"minecraft:storage",storage:"foxcraft_dungeon_loot:items",path:"grasp_of_uthiir.string_count"},right:1}
    }
}

function on_uninstall {
    data remove storage foxcraft_dungeon_loot:items grasp_of_uthiir
}

# Gives the target the grasp of uthiir.
function give_grasp_of_uthiir {
    loot give @s loot foxcraft_dungeon_loot:item/rare/grasp_of_uthiir
}
