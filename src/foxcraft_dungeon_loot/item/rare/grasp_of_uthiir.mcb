import ../../../config.js
import ../../../macros.mcbt

# Relevant Entity Tags:
# satyrn.fdl.graspOfUthiir.heldItem - A player that is holding the X No Evil item
# satyrn.fdl.graspOfUthiir.thrower - The player who threw it while the projectile is in flight, never counts as a hit entity
# satyrn.fdl.graspOfUthiir.projectile - The snowball thrown by a player who used X No Evil
# satyrn.fdl.graspOfUthiir.projectileTracker - A marker which is teleported onto the projectile every tick. It has no hitbox, so the
#   snowball cannot strike it, and it is left behind where the projectile stopped.
# satyrn.fdl.graspOfUthiir.areaOfEffect - The area of effect cloud created by the projectile.

function on_snowball_used {
    # Execute if a tagged player threw a snowball.
    execute if entity @s[tag=satyrn.fdl.graspOfUthiir.heldItem] run {
        tag @s add satyrn.fdl.graspOfUthiir.thrower
        # Execute the following as the nearest snowball, presumably the one thrown by the player.
        execute as @e[type=minecraft:snowball,limit=1,sort=nearest] at @s run {
            # Tag the snowball as the projectile.
            tag @s add satyrn.fdl.graspOfUthiir.projectile

            # Summon the tracker on the projectile. An armor stand was struck by the snowball and had its own physics.
            summon minecraft:marker ~ ~ ~ {Tags:[satyrn.fdl.graspOfUthiir.projectileTracker]}
        }
    }
}

# Occurs once per player per tick.
function on_tick {
    # A tag is added to the player while they are holding X No Evil and is cleared from any player not holding X No Evil.
    execute as @a[predicate=!foxcraft_dungeon_loot:item/rare/grasp_of_uthiir/in_main_hand,predicate=!foxcraft_dungeon_loot:item/rare/grasp_of_uthiir/in_off_hand] run tag @s remove satyrn.fdl.graspOfUthiir.heldItem

    execute as @a[predicate=foxcraft_dungeon_loot:entity/inventory/is_mainhand_snowball,predicate=!foxcraft_dungeon_loot:item/rare/grasp_of_uthiir/in_main_hand] run tag @s remove satyrn.fdl.graspOfUthiir.heldItem

    execute as @a[predicate=foxcraft_dungeon_loot:item/rare/grasp_of_uthiir/in_main_hand] run tag @s add satyrn.fdl.graspOfUthiir.heldItem

    execute as @a[predicate=!foxcraft_dungeon_loot:entity/inventory/is_mainhand_snowball,predicate=foxcraft_dungeon_loot:item/rare/grasp_of_uthiir/in_off_hand] run tag @s add satyrn.fdl.graspOfUthiir.heldItem

    execute as @e[tag=satyrn.fdl.graspOfUthiir.projectileTracker] at @s run {
        # If the tracker is near a projectile, move onto it. A snowball covers up to 1.5 blocks a tick, so look wider than one.
        execute if entity @e[tag=satyrn.fdl.graspOfUthiir.projectile,distance=..4,limit=1,sort=nearest] run {
            tp @s @e[tag=satyrn.fdl.graspOfUthiir.projectile,distance=..4,limit=1,sort=nearest]
        } else run {
            # A snowball that struck an entity leaves the web on the entity, otherwise on the tracker, which trails the impact by a tick.
            execute if entity @e[type=!#foxcraft_dungeon_loot:non_living,tag=!satyrn.fdl.graspOfUthiir.thrower,distance=..2] run {
                execute at @e[type=!#foxcraft_dungeon_loot:non_living,tag=!satyrn.fdl.graspOfUthiir.thrower,distance=..2,sort=nearest,limit=1] run function foxcraft_dungeon_loot:item/rare/grasp_of_uthiir/place_web
            } else run {
                function foxcraft_dungeon_loot:item/rare/grasp_of_uthiir/place_web
            }

            # Clean up tracking entity
            IF (config.dev) {
                particle minecraft:end_rod ~ ~ ~ 0.1 0.1 0.1 0.02 20
            }
            tag @a remove satyrn.fdl.graspOfUthiir.thrower
            kill @s
        }
    }
}

# Places cobwebs around the position of the executor and spawns the item.
function place_web {
    execute store success score #test <%config.internalScoreboard%> run setblock ~ ~ ~ minecraft:cobweb keep
    execute if score #test <%config.internalScoreboard%> matches 0 store success score #test <%config.internalScoreboard%> run setblock ~ ~1 ~ minecraft:cobweb keep
    execute if score #test <%config.internalScoreboard%> matches 0 store success score #test <%config.internalScoreboard%> run setblock ~ ~-1 ~ minecraft:cobweb keep
    execute if score #test <%config.internalScoreboard%> matches 0 store success score #test <%config.internalScoreboard%> run setblock ~1 ~ ~ minecraft:cobweb keep
    execute if score #test <%config.internalScoreboard%> matches 0 store success score #test <%config.internalScoreboard%> run setblock ~-1 ~ ~ minecraft:cobweb keep
    execute if score #test <%config.internalScoreboard%> matches 0 store success score #test <%config.internalScoreboard%> run setblock ~ ~ ~1 minecraft:cobweb keep
    execute if score #test <%config.internalScoreboard%> matches 0 store success score #test <%config.internalScoreboard%> run setblock ~ ~ ~-1 minecraft:cobweb keep
    execute if score #test <%config.internalScoreboard%> matches 0 store success score #test <%config.internalScoreboard%> run setblock ~1 ~ ~-1 minecraft:cobweb keep
    execute if score #test <%config.internalScoreboard%> matches 0 store success score #test <%config.internalScoreboard%> run setblock ~-1 ~ ~-1 minecraft:cobweb keep
    execute if score #test <%config.internalScoreboard%> matches 0 store success score #test <%config.internalScoreboard%> run setblock ~1 ~ ~1 minecraft:cobweb keep
    execute if score #test <%config.internalScoreboard%> matches 0 store success score #test <%config.internalScoreboard%> run setblock ~-1 ~ ~1 minecraft:cobweb keep
    execute if score #test <%config.internalScoreboard%> matches 0 store success score #test <%config.internalScoreboard%> run loot spawn ~ ~ ~ loot foxcraft_dungeon_loot:item/rare/grasp_of_uthiir
}

# Gives the target the grasp of uthiir.
function give_grasp_of_uthiir {
    loot give @s loot foxcraft_dungeon_loot:item/rare/grasp_of_uthiir
}
