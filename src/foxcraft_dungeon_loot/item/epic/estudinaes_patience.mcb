# TAGS USED
# satyrn.fdl.estudinaesPatience.effectsApplied - Players who have had the item's effect applied to them.

# Occurs once per 10 ticks
function clock_10t {
    schedule function foxcraft_dungeon_loot:item/epic/estudinaes_patience/clock_10t 10t
    # Apply the effect to players who are wearing Estudinae's Patience but who do not currently have the item's effects.
    execute as @a[predicate=foxcraft_dungeon_loot:item/epic/estudinaes_patience/worn,predicate=!foxcraft_dungeon_loot:item/epic/estudinaes_patience/has_effects] run {
        tag @s add satyrn.fdl.estudinaesPatience.effectsApplied
        effect give @s minecraft:weakness 1000000 4
    }
    # Remove the effect from players who are not wearing Estudinae's Patience but have had the effect applied to them.
    execute as @a[predicate=!foxcraft_dungeon_loot:item/epic/estudinaes_patience/worn,tag=satyrn.fdl.estudinaesPatience.effectsApplied] run {
        effect clear @s minecraft:weakness
        tag @s remove satyrn.fdl.estudinaesPatience.effectsApplied
    }
}

# Occurs when the datapack is loaded.
function on_load {
    schedule function foxcraft_dungeon_loot:item/epic/estudinaes_patience/clock_10t 3t
}

# Gives the target the estudinaes patience.
function give_estudinaes_patience {
    loot give @s loot foxcraft_dungeon_loot:item/epic/estudinaes_patience
}

# Gives the chainmail variant, loot variant score 1.
function give_estudinaes_patience_chainmail {
    scoreboard players set @s satyrn.fdl.loot.variant 1
    loot give @s loot foxcraft_dungeon_loot:item/epic/estudinaes_patience
    scoreboard players reset @s satyrn.fdl.loot.variant
}

# Gives the iron variant, loot variant score 2.
function give_estudinaes_patience_iron {
    scoreboard players set @s satyrn.fdl.loot.variant 2
    loot give @s loot foxcraft_dungeon_loot:item/epic/estudinaes_patience
    scoreboard players reset @s satyrn.fdl.loot.variant
}

# Gives the diamond variant, loot variant score 3.
function give_estudinaes_patience_diamond {
    scoreboard players set @s satyrn.fdl.loot.variant 3
    loot give @s loot foxcraft_dungeon_loot:item/epic/estudinaes_patience
    scoreboard players reset @s satyrn.fdl.loot.variant
}

# Gives the netherite variant, loot variant score 4.
function give_estudinaes_patience_netherite {
    scoreboard players set @s satyrn.fdl.loot.variant 4
    loot give @s loot foxcraft_dungeon_loot:item/epic/estudinaes_patience
    scoreboard players reset @s satyrn.fdl.loot.variant
}
