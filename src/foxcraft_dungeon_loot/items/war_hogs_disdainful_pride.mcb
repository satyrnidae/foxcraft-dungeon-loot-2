import ../../config.js
import ../../macros.mcbt

# Occurs when a player falls.
function on_fall {
    execute if entity @s[predicate=foxcraft_dungeon_loot:items/war_hogs_disdainful_pride/worn] run {
        playsound foxcraft_dungeon_loot:item.war_hogs_disdainful_pride.parachute_activation player @a ~ ~ ~ 1.0 1.5
        effect give @s minecraft:slow_falling 3 1

        execute unless entity @s[gamemode=creative] run {
            execute if entity @s[predicate=foxcraft_dungeon_loot:items/feet_have_unbreaking] run {
                execute store result score #math.input1 <%config.internalScoreboard%> run data get entity @s Inventory[{Slot:100b}].components."minecraft:enchantments"."minecraft:unbreaking"
                function foxcraft_dungeon_loot:math/should_damage_armor
                execute if score #math.result <%config.internalScoreboard%> matches 1 run item modify entity @s armor.feet foxcraft_dungeon_loot:mythic/war_hogs_disdainful_pride/damage_slow_falling
            } else run {
                item modify entity @s armor.feet foxcraft_dungeon_loot:mythic/war_hogs_disdainful_pride/damage_slow_falling
            }

            execute if entity @s[predicate=foxcraft_dungeon_loot:items/boots_broken] run {
                break_item armor.feet {id:"minecraft:netherite_boots"}
            }
        }
    }
}
